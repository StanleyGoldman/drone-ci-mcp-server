# -----------------------------------------------------------------------
# Drone CI connection
# -----------------------------------------------------------------------

# URL of your Drone CI server (no trailing slash)
DRONE_SERVER=http://drone.example.com

# Drone CI personal access token
# Create one at: http://your-drone-server/account
DRONE_TOKEN=your_drone_personal_access_token
# Alternative: point to a file containing the token (Docker secrets convention)
# DRONE_TOKEN_FILE=/run/secrets/drone_token

# -----------------------------------------------------------------------
# MCP server
# -----------------------------------------------------------------------

# Port the MCP server listens on (default: 8080)
MCP_PORT=8080

# Optional bearer token to protect the MCP endpoint.
# When set, every request must include: Authorization: Bearer <token>
# Leave empty to disable auth (suitable for trusted local networks).
# In Claude Desktop config, add: "headers": {"Authorization": "Bearer <token>"}
MCP_AUTH_TOKEN=
# Alternative: point to a file containing the token (Docker secrets convention)
# MCP_AUTH_TOKEN_FILE=/run/secrets/mcp_auth_token

# -----------------------------------------------------------------------
# OAuth 2.0 (required for claude.ai integration)
# -----------------------------------------------------------------------

# When both are set, the server exposes OAuth 2.0 endpoints so claude.ai can
# authenticate using client credentials instead of a static bearer token.
# MCP_AUTH_TOKEN must also be set — it is returned as the OAuth access token.
#
# Pick any non-guessable values, e.g.:  openssl rand -hex 32
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Alternative: point to a file containing the secret (Docker secrets convention)
# OAUTH_CLIENT_SECRET_FILE=/run/secrets/oauth_client_secret

# -----------------------------------------------------------------------
# Caddy reverse proxy (only needed for docker-compose.caddy.yml)
# -----------------------------------------------------------------------

# Fully-qualified domain name pointing to this host.
# Caddy will automatically obtain a TLS certificate for this domain.
MCP_HOSTNAME=drone-mcp.example.com
